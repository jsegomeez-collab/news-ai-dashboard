# === API de Anthropic (obligatorio) ===
# Genera una clave en https://console.anthropic.com  ·  NUNCA la subas a un repo.
ANTHROPIC_API_KEY=sk-ant-...

# === Acceso al dashboard (recomendado en producción) ===
# Si DASHBOARD_PASSWORD está vacía, la app queda ABIERTA (cómodo en local).
# Defínela al desplegar para proteger todo con usuario/contraseña.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# === Base de datos ===
# En hosts con disco persistente, apunta al volumen montado (p.ej. /data/app.db).
# En local puedes dejarlo vacío (usa ./data/app.db).
DB_PATH=

# === Modelos (IDs exactos; no añadir sufijos de fecha) ===
MODEL_CLASSIFY=claude-haiku-4-5
MODEL_GENERATE=claude-sonnet-4-6
MODEL_PREMIUM=claude-opus-4-8

# === Comportamiento del worker ===
POLL_CRON=*/10 * * * *        # cada 10 minutos
RELEVANCE_THRESHOLD=70         # score mínimo (0-100) para generar guion
NEWS_MIN_RELEVANCE=55          # score mínimo para MOSTRAR la noticia en el feed
AI_PREFILTER=true              # descarta al ingerir lo que claramente no es IA
GENERATE_FORMATS=reel,youtube # formatos a generar: reel y/o youtube
USE_BATCH_CLASSIFY=true        # clasificar por lotes (50% más barato; async)

# === Topes de gasto (modo continuo) ===
MAX_SCRIPTS_PER_DAY=20
MAX_DAILY_USD=5

# === Fuentes (coma-separadas; vacío = todas las por defecto) ===
REDDIT_SUBS=ClaudeAI,Anthropic,artificial,OpenAI,singularity,LocalLLaMA
# RSS y Hacker News se configuran en src/lib/sources/feeds.ts

# === Twitter/X (desactivado por ahora) ===
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=
